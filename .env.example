# AILoveShen の環境変数。このファイルを .env にコピーして値を書く（.env は git に入らない）:
#   cp .env.example .env
#
# 読むもの:
# - Python（load_settings）: リポジトリ直下の .env。config/*.yaml の ${VAR} に入る
# - ブリッジ（cd minecraft-bridge && npm start）: 同じ .env（minecraft-bridge/src/env.mjs）
# - Docker Compose: --env-file で渡す
#     docker compose --env-file .env -f docker/docker-compose.minecraft.yml up -d
# シェルで export した環境変数があれば、そちらが優先する。

# --- Gemini（必須） ---
GEMINI_API_KEY=

# --- Jev（TypeSafe AI）（Minecraft をプレイするとき必須） ---
TYPESAFE_API_KEY=

# --- 設定の環境（config/<APP_ENV>.yaml を default.yaml に重ねる） ---
APP_ENV=development

# --- Minecraft サーバーとブリッジ（既定のままでよい） ---
MC_HOST=localhost
MC_PORT=25565
BOT_NAME=AILoveShen
BRIDGE_PORT=3000
# Python からブリッジへの接続先（ブリッジは 127.0.0.1 で待ち受ける）
BRIDGE_HOST=localhost
# 配信の視点のクライアント（Minecraft 1.21.4）がつなぐポート
MIRROR_PORT=25578
# docker-compose.minecraft.yml の RCON（ローカル専用）
MC_RCON_PASSWORD=ailoveshen-dev

# --- TTS サーバー（docker/docker-compose.yml） ---
# TTS_PORT=5001
# BERT_PATH=../Style-Bert-VITS2/bert
# MODEL_ASSETS_PATH=../Style-Bert-VITS2/model_assets

# --- Twitch（Phase 4、まだ使わない） ---
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=

# --- OBS WebSocket（Phase 7、まだ使わない） ---
OBS_PASSWORD=
