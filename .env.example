# AILoveShen の環境変数。このファイルを .env にコピーして値を書く（.env は git に入らない）:
#   cp .env.example .env
#
# 読むもの:
# - Python（load_settings）: リポジトリ直下の .env。config/*.yaml の ${VAR} に入る
# - ブリッジ（cd minecraft-bridge && npm start）: 同じ .env（minecraft-bridge/src/env.mjs）
# - Docker Compose: --env-file で渡す
#     docker compose --env-file .env -f docker/docker-compose.minecraft.yml up -d
# シェルで export した環境変数があれば、そちらが優先する。

# --- LLM（必須）: クラウドのモデルはすべて LiteLLM 経由（下の Remote LLM）---

# --- Jev（TypeSafe AI）（Minecraft をプレイするとき必須） ---
TYPESAFE_API_KEY=

# --- 設定の環境（config/<APP_ENV>.yaml を default.yaml に重ねる） ---
APP_ENV=development

# --- Minecraft サーバーとブリッジ（既定のままでよい） ---
MC_HOST=localhost
MC_PORT=25565
BOT_NAME=AILoveShen
BRIDGE_PORT=3000
# 既定（空）は free: 作業知識の断り（設計したマスにしか植えない、整地の保護、断られた手の台帳など）を警告にして通す（設計書 124）。standard にすると断る（比較用）
BRIDGE_GUARDS=
# 1 にすると、技が本物の mineflayer の bot を触れる（設計書 168。メインプロセスで動き、反射以外の安全の断りが掛からない）。ブリッジと Python の両方に効く。使い捨ての世界でだけ
BRIDGE_RAW_BOT=
# Python からブリッジへの接続先（ブリッジは 127.0.0.1 で待ち受ける）
BRIDGE_HOST=localhost
# 配信の視点のクライアント（Minecraft 1.21.4）がつなぐポート
MIRROR_PORT=25578
# ワールド（docs/streaming.md「ワールドを作り直す」）。名前を変えると新しいワールドになる（前のワールドは残る）。
# シードは空ならランダム。下は平原の浜辺で、近くに村が 3 つあるとされるシード（ネットの記事より。
# 1.21.4 で未確認: 気に入らなければ空にしてランダムに）
MC_LEVEL=world
MC_SEED=2440578809544027161
# docker-compose.minecraft.yml の RCON（ローカル専用）
MC_RCON_PASSWORD=ailoveshen-dev

# --- TTS サーバー（docker/docker-compose.yml） ---
# TTS_PORT=5001
# BERT_PATH=../Style-Bert-VITS2/bert
# MODEL_ASSETS_PATH=../Style-Bert-VITS2/model_assets

# --- Twitch のチャット（python -m ailoveshen.stream が読む） ---
# 配信するチャンネル名（twitch.tv/<ここ>）。匿名で読むだけなのでトークンは要らない。空なら読まない
TWITCH_CHANNEL=
# チャットに書き込むとき（!commands の一覧）: chat:edit 付きのユーザーアクセストークンと、そのアカウントの
# ログイン名（空ならチャンネル名＝配信者のアカウント）。トークンが空なら読むだけ（一覧は声で言う）
TWITCH_ACCESS_TOKEN=
TWITCH_BOT_LOGIN=
# フォロー通知（EventSub）: Client-Id（dev.twitch.tv/console で登録。public でよい）を書くだけで、トークンは
# 自動で取って更新する（初回の起動でログに出る URL を配信者本人が開いて許可する。docs/streaming.md）。
# Client Secret は要らない（confidential クライアントなら書く）。TWITCH_EVENTSUB_TOKEN は手で作った
# トークンを使うときだけ（更新はされない。普通は空）。
# フォロー以外の応援（サブスク、ギフト、ビッツ、レイド）はトークンなしでチャットの接続から届く
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_TOKEN=

# --- TTS（Style-Bert-VITS2。--speak のとき） ---
# Style-Bert-VITS2/model_assets/ の下の、読み上げに使うモデルのディレクトリ名
TTS_MODEL_NAME=shen
# 読み上げの方式: style_bert_vits2（既定、Docker）/ irodori（Irodori-TTS-Server を Mac で直接動かす。
# docs/setup/irodori_tts.md）
# TTS_ENGINE=irodori
# Irodori-TTS の声（tools/irodori_voice.py で作った名前）とサーバー
# IRODORI_VOICE=shen
# tools/irodori_from_sbv2.py train で作った LoRA のフォルダー（サーバーのマシンの絶対パス）
# IRODORI_LORA=
# IRODORI_HOST=localhost
# サーバーの .env に IRODORI_API_KEY を決めたときだけ
# IRODORI_API_KEY=

# --- OBS WebSocket（配信の画面を LLM に見せる。docs/design/23） ---
# OBS の「ツール」→「WebSocket サーバー設定」→「接続情報を表示」のパスワード（API キーではない）
OBS_PASSWORD=
# ゲーム（ボットの視点のクライアント）を映している OBS のソース名。LLM がこれを画像で見る
OBS_GAME_SOURCE=Minecraft

# Remote LLM (docs/design/127): calls with images, calls too long for the local model, failures, and
# everything when the local LLM is off go to a model served by LiteLLM (Claude, Gemini, ...). There is no
# direct call to a cloud API: no GEMINI_API_KEY. A model whose name starts with "claude" gets Claude's
# thinking setting and prompt cache; other models (gemini-...) get their thinking depth as reasoning_effort.
LITELLM_MODEL=claude-haiku-5-5               # the model name LiteLLM serves (required), e.g. claude-haiku-5-5, gemini-3.8-flash
# LITELLM_URL=https://llm.ideta.net/v1       # the LiteLLM proxy's OpenAI-compatible endpoint (default)
# LITELLM_CODE_MODEL=                        # a stronger model for the purposes that write code (skill_write, check_write), e.g. claude-sonnet-5-5; empty: the model above
# LITELLM_ADVISOR_MODEL=                     # a model the playing LLM asks when unsure (the ask_advisor tool), e.g. claude-sonnet-5-5; empty: no advisor
# CODE_LLM=remote                            # with the local LLM on: write code (skills, checks) on the LiteLLM model above and keep everything else local (default: local)
# LITELLM_API_KEY=                           # the proxy's master key (required): kept in pass as LITE_LLM_MASTER_KEY (do not write it here;
#   start with LITELLM_API_KEY="$(pass show LITE_LLM_MASTER_KEY)" python -m ailoveshen.stream)

# Local LLM (docs/design/36): text calls to an OpenAI-compatible server, images go to the remote LLM
# LOCAL_LLM=1
# LOCAL_LLM_URL=http://127.0.0.1:1919/v1     # FreeToken; Ollama: http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=                           # empty: the first model the server lists
# LOCAL_LLM_API_KEY=                         # only if the server asks for one
