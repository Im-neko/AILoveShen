# AILoveShen Docker Environment Variables
# Copy this file to .env and customize as needed
# Usage: cp .env.example .env

# TTS Server port (default: 5001)
TTS_PORT=5001

# Paths to model files
# Use relative paths for development, absolute paths for production
BERT_PATH=../Style-Bert-VITS2/bert
MODEL_ASSETS_PATH=../Style-Bert-VITS2/model_assets

# For production, use absolute paths:
# BERT_PATH=/path/to/AILoveShen/Style-Bert-VITS2/bert
# MODEL_ASSETS_PATH=/path/to/AILoveShen/Style-Bert-VITS2/model_assets
