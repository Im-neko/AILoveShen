{
  "name": "ailoveshen-minecraft-bridge",
  "private": true,
  "type": "module",
  "description": "Mineflayer sidecar for AILoveShen: goals, a dependency solver, primitive actions and a POV mirror",
  "main": "src/index.mjs",
  "scripts": {
    "start": "node --no-node-snapshot src/index.mjs",
    "test": "node --no-node-snapshot --test 'test/*.test.mjs'",
    "postinstall": "patch-package",
    "skills:clean": "node --no-node-snapshot tools/clean-skills.mjs"
  },
  "dependencies": {
    "isolated-vm": "^5.0.4",
    "minecraft-data": "^3.117.0",
    "minecraft-protocol": "1.68.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
